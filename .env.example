PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_polowijen_2026
JWT_EXPIRES_IN=1d
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ── HTTP Security ────────────────────────────────────────────
# Comma-separated exact frontend origins; required in production.
CORS_ORIGINS=http://localhost:3000
# Set to the exact trusted proxy hop count only when deployed behind a proxy.
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ── MySQL Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=kampung_polowijen

# ── Vercel Blob Storage ─────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx
